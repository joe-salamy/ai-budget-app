# Supabase Configuration (used by both frontend and serverless functions)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (server-side only, for serverless functions)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google AI (Gemini) Configuration (server-side only)
GEMINI_API_KEY=your_gemini_api_key
